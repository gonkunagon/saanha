# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง — ดูรายละเอียดใน README.md

# ฐานข้อมูล: ตอน dev ไม่ต้องตั้ง (ใช้ไฟล์ local.db) / บนเว็บจริงใช้ Turso
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# รหัสลับสำหรับเข้ารหัส session ของพนักงาน (บังคับบนเว็บจริง) — สุ่มยาวๆ อย่างน้อย 32 ตัวอักษร
AUTH_SECRET=

# ดึงข้อมูลพัสดุจากระบบ JJ Cargo (ปุ่ม "ดึง" ข้างเลขพัสดุจีนในหลังบ้าน) — ใช้บัญชีของบริษัทเราในระบบ JJ
JJ_CARGO_URL=
JJ_CARGO_USERNAME=
JJ_CARGO_PASSWORD=
# ดึงเฉพาะลูกค้าเหล่านี้ (รหัสลูกค้าใน JJ คั่นด้วย , เช่น gon,KOOK) — เว้นว่าง = ทุกลูกค้า
JJ_CARGO_CUSTOMER_CODES=
# ซิงค์อัตโนมัติทุกกี่นาที (ค่าเริ่มต้น 15 · 0 = ปิด) — ใช้ได้เมื่อเซิร์ฟเวอร์รันตลอด
JJ_CARGO_SYNC_MINUTES=15
# วิธีขนส่งของตู้/ออเดอร์ที่นำเข้าจาก JJ: truck (ค่าเริ่มต้น) หรือ sea
JJ_CARGO_METHOD=truck
# รหัสลับสำหรับซิงค์ตามเวลา (GET /api/cron/jj-sync ส่ง Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# ส่งฟอร์มขอใบเสนอราคาเข้า LINE ของทีมงาน (LINE Messaging API)
LINE_CHANNEL_ACCESS_TOKEN=
# User ID (ขึ้นต้นด้วย U) หรือ Group ID (ขึ้นต้นด้วย C) ที่จะรับแจ้งเตือน
LINE_TARGET_ID=
