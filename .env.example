# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง — ดูรายละเอียดใน README.md

# ฐานข้อมูล: ตอน dev ไม่ต้องตั้ง (ใช้ไฟล์ local.db) / บนเว็บจริงใช้ Turso
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# รหัสลับสำหรับเข้ารหัส session ของพนักงาน (บังคับบนเว็บจริง) — สุ่มยาวๆ อย่างน้อย 32 ตัวอักษร
AUTH_SECRET=

# ส่งฟอร์มขอใบเสนอราคาเข้า LINE ของทีมงาน (LINE Messaging API)
LINE_CHANNEL_ACCESS_TOKEN=
# User ID (ขึ้นต้นด้วย U) หรือ Group ID (ขึ้นต้นด้วย C) ที่จะรับแจ้งเตือน
LINE_TARGET_ID=
